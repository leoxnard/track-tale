# Supabase (project settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Random string you also pass to setWebhook as secret_token
TELEGRAM_WEBHOOK_SECRET=change-me
# Your personal Telegram user id (@userinfobot tells you) — auto-registered as owner
TELEGRAM_OWNER_ID=123456789

# Random string; Vercel cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me

# Public origin used in share links the bot sends
APP_ORIGIN=https://track-tale.vercel.app

# Garmin LiveTrack: off unless set to 1. While it is off the trip page never
# asks Garmin anything — which is one third-party request out of every page
# load — the bot declines LiveTrack links instead of promising a banner, and
# the inbound mail endpoint 404s. Nothing is lost by leaving it off; set it to
# 1 and the feature is back as it was.
LIVE_TRACKING=0

# Only relevant while LIVE_TRACKING=1.
# Optional. Turns the live banner on by itself: add track-tale-live@yourdomain
# as a Garmin LiveTrack email recipient, point Resend Inbound at
# $APP_ORIGIN/api/inbound-email, and starting a ride lights up the trip page.
# Without these the endpoint 404s and you set live links by pasting the Garmin
# link into the Telegram chat, which keeps working either way.
RESEND_API_KEY=
# The whsec_… signing secret from the Resend webhook page
RESEND_INBOUND_SECRET=

# Optional. Puts a real map behind the route on the share card that link
# previews show. Free key from https://cloud.maptiler.com/account/keys/
# Without it the card still renders, just on plain paper.
MAPTILER_KEY=
# Any raster style id from your MapTiler account; outdoor-v2 suits a bike tour.
MAPTILER_STYLE=outdoor-v2

# Optional. Which Overpass (OpenStreetMap) instance /supermarkt asks for shops
# along the route. The default public endpoint needs no key and no account;
# point this at your own instance if you ever hit its rate limits.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Analytics: a self-hosted Umami. All three are read at BUILD time (Vite bakes
# them into the browser bundle), so a container restart never picks up a change
# — it takes a rebuild. Behind a Dockerfile they must also be declared as ARG in
# the build stage, or Docker drops them and the page is built without counting.
# Leave them unset to run with no analytics at all: no script tag, no requests.
VITE_UMAMI_SRC=https://analytics.example.de/script.js
# The website's UUID from Umami → Settings → Websites. One per project.
VITE_UMAMI_WEBSITE_ID=
# Optional host allow-list (comma-separated, no protocol). Keeps preview
# deployments out of the real numbers; unset counts every host.
VITE_UMAMI_DOMAINS=track-tale.example.de
