# Supabase (project settings → API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=service-role-key

# Telegram bot (create via @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC...
# Random string you also pass to setWebhook as secret_token
TELEGRAM_WEBHOOK_SECRET=change-me
# Your personal Telegram user id (@userinfobot tells you) — auto-registered as owner
TELEGRAM_OWNER_ID=123456789

# Random string; Vercel cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=change-me

# Public origin used in share links the bot sends
APP_ORIGIN=https://track-tale.vercel.app

# Optional. Turns the live banner on by itself: add track-tale-live@yourdomain
# as a Garmin LiveTrack email recipient, point Resend Inbound at
# $APP_ORIGIN/api/inbound-email, and starting a ride lights up the trip page.
# Without these the endpoint 404s and you set live links by pasting the Garmin
# link into the Telegram chat, which keeps working either way.
RESEND_API_KEY=
# The whsec_… signing secret from the Resend webhook page
RESEND_INBOUND_SECRET=

# Optional. Puts a real map behind the route on the share card that link
# previews show. Free key from https://cloud.maptiler.com/account/keys/
# Without it the card still renders, just on plain paper.
MAPTILER_KEY=
# Any raster style id from your MapTiler account; outdoor-v2 suits a bike tour.
MAPTILER_STYLE=outdoor-v2
